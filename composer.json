{
    "name": "dsplat/multi-tenant-saas-module-cicd-gitlab",
    "description": "GitLab CI/CD 适配（分组/仓库/流水线/发布/部署）",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "dsplat/multi-tenant-saas": "^3.1",
        "dsplat/multi-tenant-saas-module-gitlab": "^3.0",
        "dsplat/multi-tenant-saas-module-cicd": "^3.0",
        "dsplat/multi-tenant-saas-base": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "MultiTenantSaas\\Modules\\CicdGitlab\\": ""
        }
    },
    "extra": {
        "saas": {
            "name": "cicd_gitlab",
            "priority": 300,
            "dependencies": [
                "cicd",
                "gitlab",
                "integration"
            ],
            "conflicts": [],
            "requires_core": ">=3.1.0 <4.0.0",
            "provider": "MultiTenantSaas\\Modules\\CicdGitlab\\CicdGitlabServiceProvider",
            "tenant_toggleable": true,
            "module_loadable": true,
            "default_tenant_enabled": false
        }
    }
}
